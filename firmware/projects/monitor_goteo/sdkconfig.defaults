CONFIG_IDF_TARGET="esp32c3"
# La consola por USB-Serial-JTAG libera GPIO20 (SW del encoder) y GPIO21 (SDA del I2C),
# que son los pines por defecto del UART0.
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Mismo tick que pruebabpw34 (donde la deteccion de gotas se probo bien)
CONFIG_FREERTOS_HZ=1000
# Bluetooth Low Energy para la comunicacion con la app (components/comunicacion): solo la pila Bluedroid como servidor GATT
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_GATTC_ENABLE=n
# Anuncio y conexion clasicos de BLE 4.2 (las funciones esp_ble_gap_* de components/comunicacion)
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
# Tabla de particiones propia: agrega la particion "registro" para el registro de la infusion (partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
